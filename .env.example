# 复制为 .env.local 后填入对应账号的凭证
# 默认对接阿里云百炼 DashScope（OpenAI 兼容 Chat Completions 接口）
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# true 时强制使用本地 deterministic mock agent（无网络也可演示）
USE_MOCK_AGENT=false

# JWT 认证密钥（至少 32 字节随机字符串，生产环境必须更换）
JWT_SECRET=your-random-32-byte-secret-here
