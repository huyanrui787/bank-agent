# 复制为 .env.local 后填入对应账号的凭证
# 默认对接阿里云百炼 DashScope（OpenAI 兼容 Chat Completions 接口）
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# true 时强制使用本地 deterministic mock agent（无网络也可演示）
USE_MOCK_AGENT=false

# JWT 认证密钥（至少 32 字节随机字符串，生产环境必须更换）
JWT_SECRET=your-random-32-byte-secret-here

# RAGFlow 知识检索引擎（独立部署，直接 HTTP API 调用；未配置时知识检索返回「知识库未接入」）
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
# 可选覆盖：召回条数 / 相似度阈值 / 超时（默认 3 / 0.2 / 10000ms）
# RAGFLOW_TOP_K=3
# RAGFLOW_SIMILARITY_THRESHOLD=0.2
# RAGFLOW_TIMEOUT_MS=10000
